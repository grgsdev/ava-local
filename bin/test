#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
EXPECTED_ROOT="/home/iomar/Dev/avamovie-platform"
LARADOCK_ROOT="/home/iomar/Dev/laradock"
COMPOSE_FILE="$LARADOCK_ROOT/docker-compose.yml"
COMPOSE_PROJECT="laradock"
CONTAINER_PROJECT="/var/www/avamovie-platform"
TEST_DATABASE="avamovie_testing"
PHPUNIT_CONFIG="phpunit.xml.dist"

usage() {
    cat <<'EOF'
Uso:
  bin/test --help
  bin/test --list
  bin/test --dry-run
  bin/test --focused tests/Unit/ExampleTest.php
  bin/test --focused tests/Feature/ProjectManagementTest.php::metodo

A suíte completa e opções destrutivas são recusadas.
EOF
}

die() { printf 'ERRO: %s\n' "$*" >&2; exit 2; }

WORKSPACE_UID="$(id -u)"
WORKSPACE_GID="$(id -g)"
[[ "$WORKSPACE_UID" =~ ^[1-9][0-9]*$ && "$WORKSPACE_GID" =~ ^[1-9][0-9]*$ ]] || die "execução local root ou UID/GID inválido não é permitida"
WORKSPACE_USER="$WORKSPACE_UID:$WORKSPACE_GID"

[[ "$REPO_ROOT" == "$EXPECTED_ROOT" ]] || die "execução fora do repositório autorizado"
[[ -f "$COMPOSE_FILE" ]] || die "Compose oficial não encontrado"
[[ -f "$REPO_ROOT/$PHPUNIT_CONFIG" ]] || die "configuração versionável do PHPUnit não encontrada"
cd -- "$REPO_ROOT"
[[ ! -e "$REPO_ROOT/bootstrap/cache/config.php" ]] || die "configuração compilada não permitida para o gate de testes"

compose_exec() {
    docker compose --project-name "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" exec -T --user "$WORKSPACE_USER" --workdir "$CONTAINER_PROJECT" workspace "$@"
}

runtime_env=(
    APP_ENV=testing
    APP_DEBUG=true
    DB_CONNECTION=mysql
    DB_HOST=mysql
    DB_PORT=3306
    DB_DATABASE="$TEST_DATABASE"
    CACHE_STORE=array
    CACHE_DRIVER=array
    SESSION_DRIVER=array
    QUEUE_CONNECTION=sync
    REDIS_HOST=redis
    REDIS_PORT=6379
)

validate_runtime() {
    local probe
    probe='require "vendor/autoload.php"; $app = require "bootstrap/app.php"; $kernel = $app->make(Illuminate\Contracts\Console\Kernel::class); $kernel->bootstrap(); $values = ["APP_ENV" => config("app.env"), "DB_CONNECTION" => config("database.default"), "DB_HOST" => config("database.connections.mysql.host"), "DB_PORT" => (string) config("database.connections.mysql.port"), "DB_DATABASE" => config("database.connections.mysql.database"), "REDIS_HOST" => config("database.redis.default.host"), "REDIS_PORT" => (string) config("database.redis.default.port")]; foreach ($values as $key => $value) { echo $key . "=" . ($value ?? "<unset>") . PHP_EOL; } if ($values["APP_ENV"] !== "testing" || $values["DB_CONNECTION"] !== "mysql" || $values["DB_HOST"] !== "mysql" || $values["DB_PORT"] !== "3306" || $values["DB_DATABASE"] !== "avamovie_testing" || $values["REDIS_HOST"] !== "redis" || $values["REDIS_PORT"] !== "6379") { exit(10); }'
    if ! compose_exec env "${runtime_env[@]}" php -r "$probe" >/dev/null; then
        die "ambiente efetivo não passou nos gates locais"
    fi
}

validate_target() {
    local target="$1"
    [[ -n "$target" && "$target" != -* && "$target" != *$'\n'* && "$target" != *..* ]] || die "alvo inválido"
    if [[ "$target" == *::* ]]; then
        local path="${target%%::*}"
        local method="${target##*::}"
        [[ "$path" == tests/Feature/*.php ]] || die "alvo Feature deve ser arquivo explícito"
        [[ "$method" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "método focado inválido"
        [[ -f "$REPO_ROOT/$path" ]] || die "arquivo de teste inexistente"
    else
        [[ "$target" == tests/Unit/*.php ]] || die "arquivo sem método só é permitido para teste Unit explícito"
        [[ -f "$REPO_ROOT/$target" ]] || die "arquivo de teste inexistente"
    fi
}

case "${1:-}" in
    --help)
        [[ $# -eq 1 ]] || die "argumentos adicionais não permitidos com --help"
        usage
        ;;
    --list)
        [[ $# -eq 1 ]] || die "argumentos adicionais não permitidos com --list"
        printf '%s\n' 'PHPUnit: ./vendor/bin/phpunit --configuration phpunit.xml.dist (somente alvo explícito via --focused)'
        printf '%s\n' 'Banco de testes: avamovie_testing em mysql:3306'
        printf '%s\n' 'NPM: nenhum script de teste declarado em package.json'
        ;;
    --dry-run)
        [[ $# -eq 1 ]] || die "argumentos adicionais não permitidos com --dry-run"
        printf '%s\n' 'DRY-RUN: nenhum comando de teste será executado'
        printf '%s\n' 'A execução real exige --focused <alvo> e gates testing/mysql/mysql/avamovie_testing/redis.'
        ;;
    --focused)
        [[ $# -eq 2 ]] || die "uso: bin/test --focused <alvo>"
        target="$2"
        validate_target "$target"
        validate_runtime
        phpunit_args=("$target")
        if [[ "$target" == *::* ]]; then
            phpunit_args=("${target%%::*}" --filter "${target##*::}")
        fi
        printf '%s\n' "Executando alvo focado: $target"
        compose_exec env "${runtime_env[@]}" ./vendor/bin/phpunit --configuration "$PHPUNIT_CONFIG" --colors=never "${phpunit_args[@]}"
        ;;
    '')
        die 'suíte completa não está autorizada; use --focused <alvo>'
        ;;
    *)
        die "argumento desconhecido: $1"
        ;;
esac
