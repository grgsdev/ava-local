{
    "name": "EstablishmentCategory",
    "version": "V1",
    "softDeletes": true,
    "timestamps": true,
    "useIsActive": true,
    "logsActivity": true,
    "modelCache": true,
    "attributes": [
        {
            "name": "name",
            "type": "string",
            "required": true,
            "validate": true,
            "searchAble": true,
            "translated": true,
            "description": "Nome da categoria (ex: Gastronomia, Moda Autoral).",
            "example": "Gastronomia"
        },
        {
            "name": "slug",
            "type": "string",
            "required": true,
            "unique": true,
            "validate": true,
            "description": "URL amigável para a categoria."
        },
        {
            "name": "description",
            "type": "text",
            "nullable": true,
            "validate": true,
            "description": "Uma breve descrição da categoria."
        },
        {
            "name": "color",
            "type": "string",
            "length": 20,
            "nullable": true,
            "validate": true,
            "description": "Cor de apresentação da categoria em hexadecimal (ex: #FF5733).",
            "example": "#FF5733"
        },
        {
            "name": "icon",
            "type": "image",
            "multiple": false,
            "nullable": true,
            "validate": true,
            "description": "Ícone visual para a categoria."
        }
    ],
    "relations": []
}
