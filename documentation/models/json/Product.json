{
    "name": "Product",
    "version": "V1",
    "softDeletes": true,
    "timestamps": true,
    "useIsActive": true,
    "useScribe": true,
    "logsActivity": true,
    "modelCache": true,
    "attributes": [
        {
            "name": "name",
            "type": "string",
            "required": true,
            "validate": true,
            "searchAble": true,
            "description": "Nome do produto ou serviço.",
            "example": "Destaque na Página Inicial (1 Semana)"
        },
        {
            "name": "description",
            "type": "text",
            "nullable": true,
            "validate": true,
            "description": "Descrição detalhada do que o produto/serviço inclui."
        },
        {
            "name": "price",
            "type": "decimal",
            "precision": 10,
            "scale": 2,
            "required": true,
            "validate": true,
            "description": "Preço do produto ou serviço.",
            "example": "150.00"
        },
        {
            "name": "image",
            "type": "image",
            "multiple": false,
            "nullable": true,
            "validate": true,
            "description": "Imagem de apresentação do produto ou serviço."
        }
    ],
    "relations": []
}
