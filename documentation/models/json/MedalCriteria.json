{
    "name": "MedalCriteria",
    "version": "V1",
    "timestamps": true,
    "softDeletes": true,
    "useIsActive": true,
    "logsActivity": true,
    "modelCache": true,
    "attributes": [
        {
            "name": "action_type",
            "type": "string",
            "required": true,
            "validate": true,
            "description": "A ação que o usuário precisa de fazer (ex: check_in, referral, purchase).",
            "example": "check_in"
        },
        {
            "name": "count_required",
            "type": "integer",
            "required": true,
            "default": "1",
            "validate": true,
            "description": "Quantas vezes a ação precisa de ser feita.",
            "example": 5
        },
        {
            "name": "constraints",
            "type": "json",
            "nullable": true,
            "validate": true,
            "description": "Condições adicionais em JSON (ex: { \"distinct\": \"establishment_id\" })."
        }
    ],
    "relations": [
        {
            "name": "medal",
            "type": "belongsTo",
            "related": "Medal",
            "description": "A medalha à qual este critério pertence."
        }
    ]
}
